#!/bin/sh
# copy-file-ref <file> <start line> <end line>
# Copies "/full/path:line" (or "/full/path:start-end") to the macOS clipboard,
# with symlinks resolved. Used by space L.
file="$1"
case "$file" in
    "~"/*) file="$HOME/${file#\~/}" ;;
esac
# relative paths resolve against Helix's cwd; keep the name as-is if it
# can't be resolved (e.g. a new, unsaved file)
file="$(realpath "$file" 2>/dev/null || printf '%s' "$file")"
if [ "$2" = "$3" ]; then
    printf '%s:%s' "$file" "$2"
else
    printf '%s:%s-%s' "$file" "$2" "$3"
fi | pbcopy
printf 'reference copied'
