// Fresh config (JSONC), linked to ~/.config/fresh. Only settings that differ
// from Fresh's defaults; `fresh --cmd config show` prints the full result.
// Soft wrap, current-line highlight, tabs and system clipboard are already on
// by default.
{
  // themes/auto.json (named "auto") is written by theme-sync/sync-theme:
  // catppuccin latte or mocha
  "theme": "auto",
  // Homebrew manages updates; this also turns off the startup telemetry ping
  "check_for_updates": false,
  "self_update": false,
  "editor": {
    "relative_line_numbers": true,
    "cursor_style": "steady_bar",
    "indentation_guide": "all"
  },
  // Fresh doesn't start servers on its own by default; start the installed
  // ones automatically, like Helix does. Missing binaries are just flagged.
  "lsp": {
    "c": {
      "auto_start": true,
      "enabled": true,
      "process_limits": {
        "max_memory_percent": 50,
        "max_cpu_percent": 90,
        "enabled": false
      }
    },
    "cpp": {
      "auto_start": true,
      "enabled": true,
      "process_limits": {
        "max_memory_percent": 50,
        "max_cpu_percent": 90,
        "enabled": false
      }
    },
    "rust": {
      "auto_start": true,
      "enabled": true,
      "process_limits": {
        "max_memory_percent": 50,
        "max_cpu_percent": 90,
        "enabled": true
      }
    },
    "swift": {
      "auto_start": true,
      "enabled": true,
      "process_limits": {
        "max_memory_percent": 50,
        "max_cpu_percent": 90,
        "enabled": false
      }
    },
    "latex": {
      "auto_start": true,
      "enabled": true,
      "process_limits": {
        "max_memory_percent": 50,
        "max_cpu_percent": 90,
        "enabled": false
      }
    },
    // installed by checks/lsp.sh
    "python": { "auto_start": true },
    "typescript": { "auto_start": true },
    "javascript": { "auto_start": true },
    "lua": { "auto_start": true },
    "toml": { "auto_start": true },
    "json": { "auto_start": true },
    "jsonc": { "auto_start": true }
  },
  "keybindings": [
    // Copy "file:line" / "file:start-end" to the clipboard (Helix: space L).
    // copy_file_ref is registered in init.ts.
    { "key": "l", "modifiers": ["ctrl", "alt"], "action": "copy_file_ref", "when": "normal" },
    // vi mode's own key maps swallow plain "normal" bindings for plugin actions
    { "key": "l", "modifiers": ["ctrl", "alt"], "action": "copy_file_ref", "when": "mode:vi-normal" },
    { "key": "l", "modifiers": ["ctrl", "alt"], "action": "copy_file_ref", "when": "mode:vi-visual" },
    { "key": "l", "modifiers": ["ctrl", "alt"], "action": "copy_file_ref", "when": "mode:vi-visual-line" },
    // Ctrl+E opens/closes the file explorer (Ctrl+B is herdr's prefix)
    { "key": "e", "modifiers": ["ctrl"], "action": "toggle_file_explorer", "when": "normal" },
    { "key": "e", "modifiers": ["ctrl"], "action": "toggle_file_explorer", "when": "file_explorer" }
  ],
  "languages": {
    // Fresh has no zsh grammar and already opens .zsh, .zshrc & co. and zsh
    // shebangs as bash; these are the zsh files from helix/languages.toml it misses.
    "zsh": {
      "extensions": ["zsh-theme"],
      "filenames": [".zimrc"],
      "grammar": "bash",
      "comment_prefix": "#",
      "auto_indent": true,
      "show_whitespace_tabs": true,
      "format_on_save": false
    }
  },
  "version": 3,
  "active_keybinding_map": "default",
  "file_browser": {
    "show_hidden": true
  },
  // No agent features or background daemon: herdr does that job.
  // A bare `fresh` is then a plain editor in this terminal.
  "auto_attach": false,
  "terminal": {
    "resume_agents": false
  },
  "plugins": {
    "welcome_screen": {
      "settings": { "showOnStartup": false }
    },
    "vi_mode": {
      "settings": { "autoStart": true }
    },
    "orchestrator": {
      "enabled": false,
      "settings": {
        "autoOpenDock": "never"
      }
    }
  }
}
