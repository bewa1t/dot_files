#!/bin/sh
# Match Alacritty + Helix to the macOS light/dark appearance.
if defaults read -g AppleInterfaceStyle 2>/dev/null | grep -q Dark; then
  flavor=mocha
else
  flavor=latte
fi
cp ~/.config/alacritty/themes/catppuccin-$flavor.toml ~/.config/alacritty/theme.toml
printf 'inherits = "catppuccin_%s"\n' $flavor > ~/.config/helix/themes/auto.toml
